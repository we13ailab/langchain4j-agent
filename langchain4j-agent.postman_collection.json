        {
          "name": "3.3 Empty message value",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support?message=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support"],
              "query": [
                {
                  "key": "message",
                  "value": ""
                }
              ]
