{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "LangChain4j AI Agent API",
    "description": "Test collection for the langchain4j-agent Spring Boot app.\n\n**Endpoints**\n- `GET /api/ai-support` — General AI chat (JavaTechieAIAgent, no tools)\n- `GET /api/ai-support/order` — Order support AI (OrderSupportAIAgent, with tools: getOrderStatus, cancelOrder)\n\n**Setup**\n1. Start the app (runs on port 9292 — see `server.port` in application.yaml).\n2. Update the `baseUrl` / `orderId*` collection variables (Collection → Variables) with your values.\n3. Watch the app console for `TOOL CALLED -> ...` logs to confirm tool invocation.\n\n**Error scenarios note**: tool errors (order not found / cancel shipped) may return either `200` (LLM handles the tool error gracefully) or `500` (exception propagates) depending on the langchain4j version — the tests accept both.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9292"
    },
    {
      "key": "orderId1",
      "value": "ORD-1001",
      "description": "An order you want to query (status/delivery)"
    },
    {
      "key": "orderId2",
      "value": "ORD-1002",
      "description": "A cancellable order (not shipped)"
    },
    {
      "key": "orderId3",
      "value": "ORD-1003",
      "description": "A SHIPPED order (cancel should fail)"
    }
  ],
  "item": [
    {
      "name": "1. General AI Chat",
      "description": "Requests against `GET /api/ai-support` — the JavaTechieAIAgent (no tools attached).",
      "item": [
        {
          "name": "1.1 Simple greeting",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support?message=Hello, who are you?",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support"],
              "query": [
                {
                  "key": "message",
                  "value": "Hello, who are you?"
                }
              ]
            },
            "description": "Basic sanity check — the agent should introduce itself. No tools involved."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response body is not empty\", function () {",
                  "    pm.expect(pm.response.text().trim()).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 General knowledge question",
          "request": {
            "method": "GET",
            "header": [],
