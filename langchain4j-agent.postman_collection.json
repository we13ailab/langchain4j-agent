      ]
    },
    {
      "name": "2. Order Support AI (tools)",
      "description": "Requests against `GET /api/ai-support/order` — the OrderSupportAIAgent with tools `getOrderStatus` and `cancelOrder`.\n\nWatch the server console for `TOOL CALLED -> ...` log lines to confirm the agent actually invoked a tool.",
      "item": [
        {
          "name": "2.1 Ask for order status (getOrderStatus tool)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support/order?message=What is the status of my order {{orderId1}}?",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support", "order"],
              "query": [
                {
                  "key": "message",
                  "value": "What is the status of my order {{orderId1}}?"
                }
              ]
            },
            "description": "Status inquiry — should trigger the `getOrderStatus` tool and answer with real DB data (status, expected delivery). Expect `TOOL CALLED -> getOrderStatus(...)` in the app console."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response body is not empty\", function () {",
                  "    pm.expect(pm.response.text().trim()).to.not.be.empty;",
                  "});",
                  "console.log(\"Agent response:\", pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Ask for delivery details (getOrderStatus tool)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support/order?message=When will order {{orderId1}} be delivered and where is it right now?",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support", "order"],
              "query": [
                {
                  "key": "message",
                  "value": "When will order {{orderId1}} be delivered and where is it right now?"
                }
              ]
            },
            "description": "Delivery + current location inquiry — should trigger `getOrderStatus` and report `expectedDelivery` and `currentLocation`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Cancel an order (cancelOrder tool)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support/order?message=Please cancel my order {{orderId2}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support", "order"],
              "query": [
                {
                  "key": "message",
                  "value": "Please cancel my order {{orderId2}}"
                }
              ]
            },
            "description": "Cancellation request — should trigger the `cancelOrder` tool. On success the order status becomes CANCELLED and expectedDelivery is cleared. ⚠️ Destructive: the change is persisted in the DB."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 500\", function () {",
                  "    pm.expect([200, 500]).to.include(pm.response.code);",
                  "});",
                  "console.log(\"Agent response:\", pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Cancel a SHIPPED order (expect rejection)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support/order?message=I want to cancel order {{orderId3}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support", "order"],
              "query": [
                {
                  "key": "message",
                  "value": "I want to cancel order {{orderId3}}"
                }
              ]
            },
            "description": "Negative scenario — the OrderService throws \"Cannot cancel an order that has already been shipped.\" Depending on the langchain4j version the agent either relays the error politely (200) or the exception propagates (500)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 500\", function () {",
                  "    pm.expect([200, 500]).to.include(pm.response.code);",
                  "});",
                  "console.log(\"Agent response:\", pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Order not found (expect error)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support/order?message=What is the status of order ORD-9999?",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support", "order"],
              "query": [
                {
                  "key": "message",
                  "value": "What is the status of order ORD-9999?"
                }
              ]
            },
            "description": "Negative scenario — unknown order ID. OrderService throws \"Order not found: ORD-9999\". The agent should NOT invent a status (per its system message)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 500\", function () {",
                  "    pm.expect([200, 500]).to.include(pm.response.code);",
                  "});",
                  "console.log(\"Agent response:\", pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 Non-order question (tools should NOT fire)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support/order?message=What is your return policy?",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support", "order"],
              "query": [
                {
                  "key": "message",
                  "value": "What is your return policy?"
                }
              ]
            },
            "description": "Control scenario — a generic support question. No `TOOL CALLED` log line should appear in the app console for this request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response body is not empty\", function () {",
                  "    pm.expect(pm.response.text().trim()).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Edge Cases",
      "description": "Validation / negative HTTP scenarios.",
      "item": [
        {
          "name": "3.1 Missing 'message' param (expect 400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support"]
