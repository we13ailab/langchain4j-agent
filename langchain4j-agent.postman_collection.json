            "description": "Empty string is treated as present by Spring, so it reaches the LLM — the agent will likely ask the user to clarify."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "console.log(\"Agent response to empty message:\", pm.response.text());"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
