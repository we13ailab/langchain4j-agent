                  "value": "What is LangChain4j?"
                }
              ]
            },
            "description": "General knowledge question — verifies the plain chat model responds."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
